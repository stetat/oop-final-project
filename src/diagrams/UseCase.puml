@startuml KBTU_UseCaseDiagram
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #FFFDE7
  BorderColor #888
  ArrowColor #555
}
skinparam actor {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
}

' ── ACTORS ──
actor "Guest\n(Unauthenticated)" as Guest
actor "Student" as Student
actor "Graduate\nStudent" as Grad
actor "Teacher" as Teacher
actor "Manager" as Manager
actor "Admin" as Admin
actor "TechSupport\nSpecialist" as TechSupport

' GraduateStudent specializes Student
Student <|-- Grad

rectangle "KBTU University System" {

  ' ────────────────────────────────────────────
  '  AUTHENTICATION
  ' ────────────────────────────────────────────
  package "Authentication & Profile" {
    usecase "Login" as UC_Login
    usecase "Register Account" as UC_Register
    usecase "Logout" as UC_Logout
    usecase "Switch Language\n(KZ / RU / EN)" as UC_Language
  }

  ' ────────────────────────────────────────────
  '  COURSE MANAGEMENT
  ' ────────────────────────────────────────────
  package "Course Management" {
    usecase "View Available Courses" as UC_ViewCourses
    usecase "Submit Course\nRegistration Request" as UC_RegCourse
    usecase "Drop Course" as UC_DropCourse
    usecase "View Marks & GPA" as UC_ViewMarks
    usecase "View Transcript" as UC_Transcript
    usecase "View Instructor Info" as UC_TeacherInfo
    usecase "Rate Teacher" as UC_Rate
    usecase "Assign Mark to Student" as UC_AssignMark
    usecase "View Pending\nRegistrations" as UC_PendingRegs
    usecase "Approve Course\nRegistration" as UC_ApproveReg
    usecase "Reject Course\nRegistration" as UC_RejectReg
    usecase "Add New Course" as UC_AddCourse
    usecase "Assign Teacher\nto Course" as UC_AssignTeacher
    usecase "Unassign Teacher\nfrom Course" as UC_UnassignTeacher
  }

  ' ────────────────────────────────────────────
  '  RESEARCH
  ' ────────────────────────────────────────────
  package "Research Management" {
    usecase "Add Research Paper" as UC_AddPaper
    usecase "View Own\nResearch Papers" as UC_ViewPapers
    usecase "Record Citation\nfor a Paper" as UC_RecordCite
    usecase "Calculate H-Index" as UC_HIndex
    usecase "Add Text Citation\nto Any Paper" as UC_TextCite
    usecase "View All\nResearch Papers" as UC_AllPapers
    usecase "View Top Cited\nResearcher" as UC_TopCited
    usecase "Set Research\nSupervisor" as UC_SetSupervisor
    usecase "View Research\nSupervisor" as UC_ViewSupervisor
    usecase "Add Diploma Project" as UC_AddDiploma
    usecase "View Diploma Projects" as UC_ViewDiploma
    usecase "Create Research\nProject" as UC_CreateProject
    usecase "Join Research\nProject" as UC_JoinProject
    usecase "Manage Project\nJoin Requests" as UC_ProjectReqs
    usecase "Request Researcher\nRole" as UC_BecomeResearcher
    usecase "Approve Researcher\nRole Request" as UC_ApproveResearcher
    usecase "Reject Researcher\nRole Request" as UC_RejectResearcher
  }

  ' ────────────────────────────────────────────
  '  JOURNAL
  ' ────────────────────────────────────────────
  package "Journal Management" {
    usecase "View Journals" as UC_ViewJournals
    usecase "Subscribe to Journal" as UC_Subscribe
    usecase "Create Research Journal" as UC_CreateJournal
  }

  ' ────────────────────────────────────────────
  '  NEWS
  ' ────────────────────────────────────────────
  package "News Management" {
    usecase "View University News" as UC_ViewNews
    usecase "Comment on News" as UC_CommentNews
    usecase "Add News Item" as UC_AddNews
    usecase "Remove News Item" as UC_RemoveNews
  }

  ' ────────────────────────────────────────────
  '  COMMUNICATION
  ' ────────────────────────────────────────────
  package "Communication" {
    usecase "View Messages" as UC_ViewMessages
    usecase "Send Message" as UC_SendMessage
    usecase "View Notifications" as UC_ViewNotif
    usecase "View Staff\nBulletin Board" as UC_ViewBoard
    usecase "Post to Staff\nBulletin Board" as UC_PostBoard
  }

  ' ────────────────────────────────────────────
  '  TECH SUPPORT
  ' ────────────────────────────────────────────
  package "Tech Support" {
    usecase "Create Support\nRequest" as UC_CreateReq
    usecase "View New Requests" as UC_ViewNewReqs
    usecase "View All Requests" as UC_ViewAllReqs
    usecase "View Request Details" as UC_ViewReqDetail
    usecase "Accept Request" as UC_AcceptReq
    usecase "Reject Request" as UC_RejectReq
    usecase "Mark Request\nas Done" as UC_DoneReq
  }

  ' ────────────────────────────────────────────
  '  STUDENT ORGANIZATIONS
  ' ────────────────────────────────────────────
  package "Student Organizations" {
    usecase "Create Organization" as UC_CreateOrg
    usecase "View Organizations" as UC_ViewOrgs
    usecase "Join Organization" as UC_JoinOrg
    usecase "View Org Members" as UC_OrgMembers
    usecase "Manage Org\nJoin Requests" as UC_OrgReqs
  }

  ' ────────────────────────────────────────────
  '  ADMINISTRATION
  ' ────────────────────────────────────────────
  package "Administration" {
    usecase "View All Users" as UC_ViewUsers
    usecase "Add User" as UC_AddUser
    usecase "Remove User" as UC_RemoveUser
    usecase "View Activity Logs" as UC_ViewLogs
    usecase "Save Database" as UC_SaveDB
    usecase "Generate Academic\nPerformance Report" as UC_Report
    usecase "View/File Complaints" as UC_Complaints
  }
}

