Student --> UC_Transcript
Student --> UC_TeacherInfo
Student --> UC_Rate
Student --> UC_ViewNews
Student --> UC_CommentNews
Student --> UC_ViewJournals
Student --> UC_Subscribe
Student --> UC_ViewMessages
Student --> UC_SendMessage
Student --> UC_ViewNotif
Student --> UC_CreateReq
Student --> UC_BecomeResearcher
Student --> UC_AllPapers
Student --> UC_TopCited
Student --> UC_TextCite
Student --> UC_CreateOrg
Student --> UC_ViewOrgs
Student --> UC_JoinOrg
Student --> UC_OrgMembers
Student --> UC_OrgReqs

' ────────────────────────────────────────────
'  GRADUATE STUDENT (inherits Student, plus research)
' ────────────────────────────────────────────
Grad --> UC_SetSupervisor
Grad --> UC_ViewSupervisor
Grad --> UC_AddDiploma
Grad --> UC_ViewDiploma
Grad --> UC_AddPaper
Grad --> UC_ViewPapers
Grad --> UC_RecordCite
Grad --> UC_HIndex
Grad --> UC_CreateProject
Grad --> UC_JoinProject
Grad --> UC_ProjectReqs

' ────────────────────────────────────────────
'  TEACHER
' ────────────────────────────────────────────
Teacher --> UC_Logout
Teacher --> UC_Language
Teacher --> UC_ViewCourses
Teacher --> UC_AssignMark
Teacher --> UC_Complaints
Teacher --> UC_ViewMessages
Teacher --> UC_SendMessage
Teacher --> UC_ViewNews
Teacher --> UC_CommentNews
Teacher --> UC_ViewJournals
Teacher --> UC_Subscribe
Teacher --> UC_ViewNotif
Teacher --> UC_CreateReq
Teacher --> UC_AllPapers
Teacher --> UC_TopCited
Teacher --> UC_TextCite
Teacher --> UC_ViewBoard
Teacher --> UC_PostBoard
Teacher --> UC_BecomeResearcher
Teacher --> UC_AddPaper
Teacher --> UC_ViewPapers
Teacher --> UC_RecordCite
Teacher --> UC_HIndex
Teacher --> UC_CreateProject
Teacher --> UC_JoinProject
Teacher --> UC_ProjectReqs

' ────────────────────────────────────────────
'  MANAGER
' ────────────────────────────────────────────
Manager --> UC_Logout
Manager --> UC_Language
Manager --> UC_PendingRegs
Manager --> UC_ApproveReg
Manager --> UC_RejectReg
Manager --> UC_AddCourse
Manager --> UC_ViewCourses
Manager --> UC_AssignTeacher
Manager --> UC_UnassignTeacher
Manager --> UC_Report
Manager --> UC_ViewNews
Manager --> UC_AddNews
Manager --> UC_RemoveNews
Manager --> UC_CommentNews
Manager --> UC_CreateJournal
Manager --> UC_ViewMessages
Manager --> UC_SendMessage
Manager --> UC_CreateReq
Manager --> UC_ViewNotif
Manager --> UC_AllPapers
Manager --> UC_TopCited
Manager --> UC_TextCite
Manager --> UC_ViewBoard
Manager --> UC_PostBoard
Manager --> UC_ApproveResearcher
Manager --> UC_RejectResearcher
Manager --> UC_Complaints

' ────────────────────────────────────────────
'  ADMIN
' ────────────────────────────────────────────
Admin --> UC_Logout
Admin --> UC_Language
Admin --> UC_ViewUsers
Admin --> UC_AddUser
Admin --> UC_RemoveUser
Admin --> UC_ViewLogs
Admin --> UC_ViewNews
Admin --> UC_CommentNews
Admin --> UC_ViewMessages
Admin --> UC_SendMessage
Admin --> UC_ViewNotif
Admin --> UC_AllPapers
Admin --> UC_TopCited
Admin --> UC_TextCite
Admin --> UC_ViewBoard
Admin --> UC_PostBoard
Admin --> UC_SaveDB

' ────────────────────────────────────────────
'  TECH SUPPORT
' ────────────────────────────────────────────
TechSupport --> UC_Logout
TechSupport --> UC_Language
TechSupport --> UC_ViewNewReqs
TechSupport --> UC_ViewAllReqs
TechSupport --> UC_ViewReqDetail
TechSupport --> UC_AcceptReq
TechSupport --> UC_RejectReq
TechSupport --> UC_DoneReq
TechSupport --> UC_ViewMessages
TechSupport --> UC_SendMessage
TechSupport --> UC_ViewNotif
TechSupport --> UC_AllPapers
TechSupport --> UC_ViewBoard
TechSupport --> UC_PostBoard

' ────────────────────────────────────────────
'  <<include>> & <<extend>> relationships
' ────────────────────────────────────────────

' Approving a registration always includes viewing pending regs
UC_ApproveReg ..> UC_PendingRegs : <<include>>
UC_RejectReg  ..> UC_PendingRegs : <<include>>

' Recording a citation always includes viewing the researcher's papers first
UC_RecordCite ..> UC_ViewPapers : <<include>>

' Setting a supervisor always internally validates the h-index
UC_SetSupervisor ..> UC_HIndex : <<include>>

' Approving/rejecting researcher requests always includes viewing the request list
UC_ApproveResearcher ..> UC_ApproveResearcher : <<include>>
UC_RejectResearcher  ..> UC_ApproveResearcher : <<include>>

' Adding a paper optionally extends to publishing in a journal
UC_AddPaper ..> UC_ViewJournals : <<extend>>

' Adding a paper optionally extends to linking to a research project
UC_AddPaper ..> UC_CreateProject : <<extend>>

' Viewing news can optionally extend to commenting
UC_CommentNews ..> UC_ViewNews : <<extend>>

' Accepting/Rejecting a request includes viewing request details
UC_AcceptReq ..> UC_ViewReqDetail : <<include>>
UC_RejectReq  ..> UC_ViewReqDetail : <<include>>
UC_DoneReq    ..> UC_ViewReqDetail : <<include>>

' Managing project join requests includes viewing them
UC_ProjectReqs ..> UC_JoinProject : <<extend>>

@enduml